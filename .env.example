# ======================================================================
# 本番環境（EC2 + RDS）用 環境変数設定
# ======================================================================
# 注意: このファイルは本番環境専用です
# 開発環境とは設定が異なります
# ======================================================================

# ======= チームで共通にする設定 =======
# =======  環境設定 =======
ENVIRONMENT=production                          # 環境: production (本番), staging (検証), development (開発)
TZ=Asia/Tokyo                                   # タイムゾーン設定

# =======  Django設定 =======
DJANGO_SETTINGS_MODULE=config.settings.prod     # 本番環境設定ファイルの参照
DJANGO_ALLOWED_HOSTS=logpon.com,*.logpon.com,logpon-prod-alb-1962711879.ap-northeast-1.elb.amazonaws.com,*.ap-northeast-1.elb.amazonaws.com,10.0.*,web,localhost,127.0.0.1
DJANGO_PORT=80                                  # Djangoのポート番号（ALB経由で80番）
DJANGO_LANGUAGE_CODE=ja                         # 言語コード（日本語）
DJANGO_TIME_ZONE=Asia/Tokyo                     # タイムゾーン

# =======  データベース設定（AWS RDS MySQL） =======
# 開発環境とは異なり、RDSを使用
MYSQL_HOST=logpon-prod-mysql.cte6w024oemb.ap-northeast-1.rds.amazonaws.com           # RDSエンドポイント（例: logpon-prod-mysql.xxx.rds.amazonaws.com）
MYSQL_PORT=3306                                 # MySQLポート
MYSQL_DATABASE=logpon_db                        # データベース名
MYSQL_USER=admin                                # RDSマスターユーザー名

# =======  AWS S3 設定 =======
AWS_STORAGE_BUCKET_NAME=logpon-sounds           # S3バケット名
AWS_S3_REGION_NAME=ap-northeast-1               # AWSリージョン
USE_S3=True                                     # S3を使用するか（本番: True, 開発: False）
#AWS_S3_CUSTOM_DOMAIN=                          # CloudFront使用時のみ設定

# =======  AWS認証情報 =======
# EC2のIAM Roleを使用するため、認証情報は不要
# AWS_ACCESS_KEY_ID=                            # 不要（IAM Roleで自動取得）
# AWS_SECRET_ACCESS_KEY=                        # 不要（IAM Roleで自動取得）

# =======  ユーザー・グループ設定 =======
USERNAME=appuser                                # コンテナ内のユーザー名
GROUPNAME=appgroup                              # コンテナ内のグループ名
UID=1000                                        # ユーザーID（EC2デフォルト）
GID=1000                                        # グループID（EC2デフォルト）

# ======= 各自で変更する設定 =======
MYSQL_PASSWORD=your_own_password                # RDSパスワード
MYSQL_ROOT_PASSWORD=your_root_pw                # RDS Rootパスワード（RDSパスワードと同じ）
DJANGO_SECRET_KEY=your_secret_key               # 本番用シークレットキー（必ず変更）
DJANGO_DEBUG=False                              # デバッグモード: 本番では必ずFalse